# Django
DJANGO_SETTINGS_MODULE=config.settings_prod
DJANGO_SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=api.incgt.link
FRONTEND_URL=https://incgt.link
COOKIE_DOMAIN=.incgt.link
CORS_ALLOWED_ORIGINS=https://incgt.link,https://www.incgt.link
CSRF_TRUSTED_ORIGINS=https://incgt.link,https://www.incgt.link

# Postgres (Neon / Render / any provider)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Cloudflare R2 (S3-compatible media storage) — free tier
USE_S3_MEDIA=True
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=incognito-media
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION_NAME=auto
# Public URL for the bucket (r2.dev subdomain or custom domain)
R2_CUSTOM_DOMAIN=pub-xxxx.r2.dev
